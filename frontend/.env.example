# Node API base URL (REST). The frontend calls /api/v1/* under this origin.
# Prefer VITE_API_BASE_URL for new environments; VITE_API_BASE remains supported.
VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE=http://localhost:3000
# Fail stalled browser requests instead of leaving loading states open indefinitely.
VITE_API_TIMEOUT_MS=15000

# Optional WebSocket endpoint for the live crisis feed.
# Local development defaults to ws://localhost:3000/ws. Production does not
# connect unless this value is explicitly configured.
VITE_WS_URL=ws://localhost:3000/ws

# Supabase project (bare origin — no /rest/v1 suffix). Used for auth + role gating.
VITE_SUPABASE_URL=https://hertsgkpnobirsnwvsns.supabase.co
