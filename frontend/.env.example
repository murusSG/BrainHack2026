# Node API base URL (REST). The frontend calls /api/v1/* under this origin.
VITE_API_BASE=http://localhost:3000

# WebSocket endpoint for the live crisis feed.
VITE_WS_URL=ws://localhost:3000/ws

# Supabase project (same project as the Node API). Used for auth + role gating.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
