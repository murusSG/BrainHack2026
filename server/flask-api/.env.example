# Flask service
FLASK_ENV=development
PORT=8000

# Node API gateway (for service-to-service calls)
NODE_API_URL=http://localhost:3000

# AI provider configuration. Put real keys in ignored .env.local, not in git.
PORT=5001
OPENAI_API_KEY=
OPENROUTER_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-5.5-nano
EXTRACTION_CONFIDENCE_THRESHOLD=0.65
AI_REQUEST_TIMEOUT_SECONDS=30

# Supabase — same project the Node API writes to (optional until DB is wired)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
