# Server
PORT=3000
NODE_ENV=development

# Supabase 
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LTA DataMall 
LTA_API_KEY=

# Public data / provider configuration
DATA_GOV_BASE_URL=https://api-open.data.gov.sg
DATA_GOV_LEGACY_BASE_URL=https://api.data.gov.sg/v1
EXTERNAL_API_TEXTERNAL_API_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=3600
ENABLE_MOCK_SCDF_INCIDENTS=false
ENABLE_MOCK_DORSCON=true

# Optional SMS notifications for resident alerts.
# Keep SMS_ENABLED=false unless you intentionally want real SMS sends.
SMS_ENABLED=false
SMS_PROVIDER=twilio
SMS_DEMO_RECIPIENTS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Optional WhatsApp Cloud API notifications for resident alerts.
# Free-form text may require the recipient to have an active WhatsApp service window.
WHATSAPP_ENABLED=false
WHATSAPP_DEMO_RECIPIENTS=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Optional Telegram Bot API notifications for resident alerts.
# Residents must start the bot first; use numeric chat IDs or @channel usernames.
TELEGRAM_ENABLED=false
TELEGRAM_DEMO_CHAT_IDS=
TELEGRAM_BOT_TOKEN=

# OneMap credentials are required only for /api/onemap routes
ONEMAP_API_BASE_URL=https://www.onemap.gov.sg
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
ONEMAP_TOKEN_CACHE_PATH=.cache/onemap-token.json

# Optional LLM narrative provider for the Foresight Engine
# Put real keys in ignored .env.secrets, not this file.
LLM_API_BASE_URL=https://api.vectorengine.ai/v1
LLM_MODEL=gpt-5.5:stable
LLM_API_KEY=

# Optional resident Ask MURUS copilot provider.
# Uses an OpenAI-compatible /chat/completions endpoint.
ASK_MURUS_LLM_API_BASE_URL=https://vectorengine.ai/v1
ASK_MURUS_LLM_MODEL=deepseek-v4-pro:stable
ASK_MURUS_LLM_API_KEY=
ASK_MURUS_TIMEOUT_MS=90000

FLASK_AI_URL=http://127.0.0.1:5001
INCIDENT_SIMILARITY_TIME_WINDOW_MINUTES=60
INCIDENT_SIMILARITY_THRESHOLD=0.75
AI_SERVICE_TIMEOUT_MS=30000

SCDF_FIRE_STATIONS_RESOURCE_ID=d_5d3d2c4f3556edb5d8c995f42e603b24
SCDF_FIRE_STATIONS_FETCH_MODE=download
SCDF_SHELTERS_RESOURCE_ID=d_291795a678b8cf82f108780a6235ce18
SCDF_SHELTERS_FETCH_MODE=datastore
SCDF_AEDS_RESOURCE_ID=d_e8934d28896a1eceecfe86f42dd3c077
SCDF_AEDS_FETCH_MODE=datastore
MOH_INFECTIOUS_DISEASES_RESOURCE_ID=d_ca168b2cb763640d72c4600a68f9909e
MOH_INFECTIOUS_DISEASES_FETCH_MODE=datastore
MOH_COVID_WEEKLY_RESOURCE_ID=d_11e68bba3b3c76733475a72d09759eeb
MOH_COVID_WEEKLY_FETCH_MODE=datastore
MOH_HEALTH_CAPACITY_RESOURCE_ID=d_74ee2734189f4124fefbf01c3fe48bec
MOH_HEALTH_CAPACITY_FETCH_MODE=datastore
MOH_BEDS_OCCUPANCY_URL=https://www.moh.gov.sg/others/resources-and-statistics/healthcare-institution-statistics-beds-occupancy-rate-(bor)/
MOH_WAITING_TIME_ADMISSION_URL=https://www.moh.gov.sg/others/resources-and-statistics/healthcare-institution-statistics-waiting-time-for-admission-to-ward/
DATA_GOV_ED_WAITING_TIMES_RESOURCE_ID=
DATA_GOV_ED_WAITING_TIMES_FETCH_MODE=datastore
HDB_BUILDINGS_RESOURCE_ID=d_17f5382f26140b1fdae0ba2ef6239d2f
HDB_BUILDINGS_FETCH_MODE=datastore
POPULATION_PLANNING_AREAS_RESOURCE_ID=d_d95ae740c0f8961a0b10435836660ce0
POPULATION_PLANNING_AREAS_FETCH_MODE=datastore
POPULATION_HOUSEHOLDS_RESOURCE_ID=d_2917c3a947cd8d8af80dbec6b587281c
POPULATION_HOUSEHOLDS_FETCH_MODE=datastore
